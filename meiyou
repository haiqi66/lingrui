<!DOCTYPE html>
<html>
<head>
<style>
body {
    background: #f5f7fa;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

/* 按钮样式 */
.power-btn {
    width: 160px;
    height: 160px;
    border-radius: 40px;
    border: none;
    background: linear-gradient(
        145deg,
        #ffc94a,
        #ff9900
    );

    color: white;
    font-size: 50px;
    cursor: pointer;

    /* 立体阴影 */
    box-shadow:
        0 10px 20px rgba(255,153,0,0.35),
        inset 0 4px 8px rgba(255,255,255,0.4);

    transition: all 0.3s ease;
}


/* 鼠标经过 */
.power-btn:hover {
    transform: translateY(-8px);
    box-shadow:
        0 18px 30px rgba(255,153,0,0.45),
        inset 0 4px 10px rgba(255,255,255,0.5);
}


/* 鼠标点击 */
.power-btn:active {
    transform: translateY(3px) scale(0.95);

    box-shadow:
        0 5px 10px rgba(255,153,0,0.3),
        inset 0 5px 12px rgba(0,0,0,0.15);
}

</style>
</head>

<body>

<button class="power-btn">
    ⚡
</button>

</body>
</html>
